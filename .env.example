# BetMates environment variables
#
# Copy this file to `.env` and fill in what you need:
#     cp .env.example .env
#
# The app runs with NONE of these set (it falls back to a localStorage mock
# and mock fixture data), so only add what a given task actually requires.
#
# `.env` is gitignored. NEVER commit real values. NEVER paste secrets into chat.

# ── Public (safe to share; shipped in the browser bundle) ───────────────────

# Supabase project — ask the owner for these to work against the real database.
# Without them, the app uses an in-browser mock instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push public key (optional; needed to test notifications in the browser).
VITE_VAPID_PUBLIC_KEY=

# Optional: show bookmaker affiliate links. Leave blank to disable.
VITE_AFFILIATE_LINKS=

# ── Secret (server-only; used by netlify/functions — DO NOT expose or commit) ─
# You almost never need these. Each function degrades to mock data when unset.

# Full-access Supabase key (bypasses row-level security). Handle with care.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push private key (pairs with VITE_VAPID_PUBLIC_KEY).
VAPID_PRIVATE_KEY=

# The Odds API — free tier is 500 requests/month, so use sparingly.
ODDS_API_KEY=

# Horse racing data provider.
RACING_API_USERNAME=
RACING_API_PASSWORD=

# Additional sports data provider.
SGO_API_KEY=

# Stock photos (Pexels).
PEXELS_API_KEY=
