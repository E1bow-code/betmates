# Copy to .env.local for local dev (vite loads .env.local automatically).
# In Netlify: Site settings -> Environment variables.
#
# Leave any of these unset and the app degrades gracefully:
# - No VITE_SUPABASE_* -> groups/tracker/auth run on a localStorage mock
#   (src/lib/localBackend.js). Nothing is lost when you add real values
#   later; you'll just start a fresh backend.
# - No ODDS_API_KEY -> netlify/functions/odds.js serves mock fixtures
#   (src/data/mockFootballOdds.js).

# Supabase project settings (Project Settings -> API). The anon key is
# public by design (safe for the client) - RLS policies in
# supabase/schema.sql do the real access control.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service role key (Project Settings -> API -> service_role, "secret").
# Server-side only, never shipped to the client - read by
# netlify/functions/kickoff-reminders.js, the one job that runs on a
# schedule with nobody signed in, so it can't rely on RLS + a user's own
# access token like every other function in this project does. Leave unset
# and kickoff reminders just no-op.
SUPABASE_SERVICE_ROLE_KEY=

# The Odds API (theoddsapi.com) key. Server-side only - read by
# netlify/functions/odds.js via process.env, never shipped to the client.
ODDS_API_KEY=

# TheSportsDB key for team crests and player headshots, read server-side by
# netlify/functions/team-badge.js and player-photo.js. Leave unset and they
# use the free public test key "3" (no registration) - fine for light use,
# but set a paid key here if the free tier's rate limits start leaving
# badges/headshots as initials-only under real traffic.
SPORTSDB_API_KEY=

# Web Push (VAPID) key pair for browser push notifications. Generate a pair
# with `npx web-push generate-vapid-keys`. The PUBLIC key is shipped to the
# client (src/lib/push.js, hence the VITE_ prefix); the PRIVATE key is
# server-side only, read by the push-sending functions
# (netlify/functions/send-push.js and the scheduled reminder jobs). Leave
# both unset and push notifications are simply disabled.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Horse racing data provider credentials. Server-side only - read by
# netlify/functions/racing.js and racing-results.js (and auto-settle.js when
# settling racing bets). Leave unset and racing falls back to mock data.
RACING_API_USERNAME=
RACING_API_PASSWORD=

# Alternate sports-odds provider key, server-side only - read by
# netlify/functions/sport.js. Leave unset and it falls back to the Odds API
# and mock fixtures.
SGO_API_KEY=

# Pexels key for stock photos, server-side only - read by
# netlify/functions/photo.js. Leave unset and photo search returns an empty
# result rather than failing.
PEXELS_API_KEY=

# Affiliate tracking links for the Copy Bet button (src/lib/bookmakers.js) -
# public by design, this is just a referral link on an outbound button, not
# a secret. JSON object, only the bookmakers you've actually signed up with
# need an entry - anything missing keeps using its plain homepage link.
# Example: {"Bet365":"https://www.bet365affiliates.com/redirect?id=XXXXX"}
#
# Where to apply (checked August 2026 - programs and terms change, verify
# current commission/requirements on each site before signing up):
# - Bet365: bet365partners.com (30% lifetime commission)
# - William Hill: affiliates.williamhill.com (30% sports/casino)
# - Ladbrokes + Coral: Entain Partners (35% - one program covers both)
# - Paddy Power: via Paddy Power's own affiliate portal
# - Sky Bet, Betfair, BetVictor, Betway, Unibet: not confirmed - check each
#   bookmaker's own site for an "Affiliates" or "Partners" link
#
# UK gambling affiliate marketing is regulated under the ASA's CAP Code
# Section 16, which applies to affiliates directly (not just operators) -
# read it before signing up, not after: asa.org.uk/type/non_broadcast/code_section/16.html
VITE_AFFILIATE_LINKS=

# The Racing API (theracingapi.com). HTTP Basic, so it's a username+password
# pair rather than a single key - see netlify/functions/racing.js. Read by
# racing.js (racecards), racing-results.js (finishing positions) and
# auto-settle.js. Unset and racing falls back to src/data/mockRacingOdds.js,
# and racing bets stop auto-settling - they keep the manual "Mark result"
# path in the Tracker.
RACING_API_USERNAME=
RACING_API_PASSWORD=

# SportsGameOdds (sportsgameodds.com) key, for the sports The Odds API
# doesn't cover well - read by netlify/functions/sport.js only. Unset and
# those sports return empty, same as "nothing on right now" elsewhere.
SGO_API_KEY=

# Pexels (pexels.com/api) key for the sport banner photos - read by
# netlify/functions/photo.js only, server-side. Purely decorative: unset and
# the banners and ambient background photos just don't render. Free tier is
# 200 req/hour, and photo.js caches one photo per sport per day.
PEXELS_API_KEY=

# Web Push (VAPID) keypair - generate with:
#   npx web-push generate-vapid-keys
# The public half is meant to ship to the client (that's what VITE_ means);
# the private half signs pushes server-side and must never be committed.
# Both must be set or every push feature no-ops: bet settled, kickoff
# reminders, odds alerts, comments, and the weekly recap. Changing the pair
# later invalidates existing subscriptions - everyone has to re-enable
# notifications - so generate once and keep it.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
