# Copy to .env.local for local dev (vite loads .env.local automatically).
# In Netlify: Site settings -> Environment variables.
#
# Leave any of these unset and the app degrades gracefully:
# - No VITE_SUPABASE_* -> groups/tracker/auth run on a localStorage mock
#   (src/lib/localBackend.js). Nothing is lost when you add real values
#   later; you'll just start a fresh backend.
# - No ODDS_API_KEY -> netlify/functions/odds.js serves mock fixtures
#   (src/data/mockFootballOdds.js).

# Supabase project settings (Project Settings -> API). The anon key is
# public by design (safe for the client) - RLS policies in
# supabase/schema.sql do the real access control.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The Odds API (theoddsapi.com) key. Server-side only - read by
# netlify/functions/odds.js via process.env, never shipped to the client.
ODDS_API_KEY=
